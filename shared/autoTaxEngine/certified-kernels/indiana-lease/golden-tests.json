    {
      "id": "GOLDEN-L-001",
      "category": "happy-path",
      "description": "Simple 36-month lease with doc fee",
      "rulesExercised": ["IN-L-001", "IN-L-002", "IN-L-003"],
      "input": {
        "dealType": "LEASE",
        "grossCapCost": 35000,
        "baseMonthlyPayment": 450,
        "paymentCount": 36,
        "residualValue": 18000,
        "docFee": 250
      },
      "expected": {
        "success": true,
        "breakdown": {
          "upfront": {
            "taxableBase": 700,
            "taxAmount": 49,
            "components": {
              "docFeeTax": 17.50,
              "firstPaymentTax": 31.50
            }
          },
          "monthly": {
            "basePayment": 450,
            "taxPerPayment": 31.50,
            "totalPaymentWithTax": 481.50
          },
          "totalTaxOverTerm": 1151.50
        }
      },
      "notes": "Upfront: ($250 + $450) × 7% = $49. Monthly: $450 × 7% = $31.50. Total: $49 + ($31.50 × 35) = $1,151.50"
    },
