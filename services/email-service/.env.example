# Server Configuration
PORT=8004

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autolytiq_email?sslmode=disable

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@autolytiq.com
SMTP_FROM_NAME=Autolytiq

# Alternative SMTP Providers:

# SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# AWS SES
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=your-ses-smtp-username
# SMTP_PASSWORD=your-ses-smtp-password

# Mailgun
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@your-domain.mailgun.org
# SMTP_PASSWORD=your-mailgun-password

# =====================================================
# Resend Configuration (RECOMMENDED - preferred over SMTP)
# =====================================================
# When RESEND_API_KEY is set, Resend will be used instead of SMTP
# Get your API key from: https://resend.com/api-keys

RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=noreply@autolytiq.com
RESEND_FROM_NAME=Autolytiq

# Webhook secret for verifying delivery events (optional)
# Get this from: https://resend.com/webhooks
# Webhook endpoint: POST /email/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxx
